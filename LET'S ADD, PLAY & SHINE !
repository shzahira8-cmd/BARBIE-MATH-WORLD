<title>Barbie Math World</title>

<style>

/* =====================================================
   BARBIE MATH WORLD
   GOOGLE SITES - CSS INTERACTIVE VERSION
===================================================== */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family:
        "Trebuchet MS",
        Arial,
        sans-serif;

    background: #fff3f9;

    color: #5c2947;
}

.page {
    width: 100%;
    overflow: hidden;

    background:
        linear-gradient(
            135deg,
            #fff8fc,
            #ffe0ef
        );
}


/* =====================================================
   NAVIGATION
===================================================== */

.navbar {

    position: sticky;
    top: 0;

    z-index: 999;

    display: flex;
    justify-content: center;
    align-items: center;

    flex-wrap: wrap;

    gap: 8px;

    padding: 13px;

    background:
        rgba(255,255,255,0.97);

    border-bottom:
        3px solid #ffb5d6;

    box-shadow:
        0 5px 18px
        rgba(190,40,110,0.12);
}

.navbar a {

    text-decoration: none;

    color: #c51c70;

    font-weight: bold;

    font-size: 14px;

    padding:
        9px 14px;

    border-radius: 25px;

    transition: 0.3s;

}

.navbar a:hover {

    background:
        #ff4fa3;

    color: white;

    transform:
        translateY(-3px);

}


/* =====================================================
   FLOATING DECORATIONS
===================================================== */

.float {

    position: absolute;

    font-size: 30px;

    pointer-events: none;

    animation:
        floatUp 5s
        ease-in-out
        infinite;

}

.heart1 {
    left: 3%;
    top: 18%;
}

.star1 {
    right: 4%;
    top: 27%;

    animation-delay: 1s;
}

.plus1 {
    left: 5%;
    top: 65%;

    color: #ff4fa3;

    animation-delay: 2s;
}

.star2 {
    right: 5%;
    bottom: 20%;

    animation-delay: 3s;
}

@keyframes floatUp {

    0%,100% {
        transform:
            translateY(0)
            rotate(-5deg);
    }

    50% {
        transform:
            translateY(-22px)
            rotate(8deg);
    }

}


/* =====================================================
   HERO
===================================================== */

.hero {

    position: relative;

    max-width: 1100px;

    min-height: 500px;

    margin:
        20px auto;

    padding:
        55px 20px;

    display:
        flex;

    flex-direction:
        column;

    justify-content:
        center;

    align-items:
        center;

    text-align:
        center;

    overflow:
        hidden;

    border-radius:
        40px;

    background:

        radial-gradient(
            circle at 10% 20%,
            rgba(255,255,255,.4),
            transparent 12%
        ),

        radial-gradient(
            circle at 90% 70%,
            rgba(255,255,255,.3),
            transparent 15%
        ),

        linear-gradient(
            135deg,
            #ed2785,
            #ff65ae,
            #ffb9db
        );

    box-shadow:
        0 20px 45px
        rgba(195,30,110,.25);

}


/* =====================================================
   HERO CIRCLES
===================================================== */

.hero:before {

    content: "";

    position: absolute;

    width: 230px;
    height: 230px;

    border-radius: 50%;

    background:
        rgba(255,255,255,.17);

    top: -80px;
    left: -70px;

}

.hero:after {

    content: "";

    position: absolute;

    width: 280px;
    height: 280px;

    border-radius: 50%;

    background:
        rgba(255,255,255,.13);

    right: -100px;
    bottom: -100px;

}


/* =====================================================
   HERO CONTENT
===================================================== */

.bow {

    position: relative;

    z-index: 5;

    font-size: 65px;

    animation:
        bounce 2s
        ease-in-out
        infinite;

}

@keyframes bounce {

    0%,100% {
        transform:
            translateY(0);
    }

    50% {
        transform:
            translateY(-12px);
    }

}


.hero h1 {

    position: relative;

    z-index: 5;

    color: white;

    font-size:
        clamp(
            38px,
            8vw,
            75px
        );

    margin-top: 10px;

    text-shadow:
        4px 4px #c3176b,
        7px 7px
        rgba(255,255,255,.2);

}

.hero h2 {

    position: relative;

    z-index: 5;

    color: white;

    font-size:
        clamp(
            20px,
            4vw,
            32px
        );

    margin-top: 12px;

}

.hero p {

    position: relative;

    z-index: 5;

    color: white;

    font-size: 18px;

    line-height: 1.7;

    margin-top: 15px;

}


/* =====================================================
   FLOATING NUMBERS
===================================================== */

.number {

    position: absolute;

    color:
        rgba(255,255,255,.7);

    font-size: 42px;

    font-weight: bold;

    animation:
        numberFloat
        5s
        infinite
        ease-in-out;

}

.num1 {
    left: 12%;
    top: 20%;
}

.num2 {
    right: 12%;
    top: 25%;

    animation-delay: 1s;
}

.num3 {
    left: 18%;
    bottom: 20%;

    animation-delay: 2s;
}

.num4 {
    right: 18%;
    bottom: 17%;

    animation-delay: 3s;
}

@keyframes numberFloat {

    0%,100% {
        transform:
            translateY(0)
            rotate(0);
    }

    50% {
        transform:
            translateY(-20px)
            rotate(12deg);
    }

}


/* =====================================================
   BUTTONS
===================================================== */

.btn {

    display:
        inline-block;

    padding:
        14px 25px;

    margin:
        8px 5px;

    border-radius:
        30px;

    text-decoration:
        none;

    font-weight:
        bold;

    color:
        #d32178;

    background:
        white;

    box-shadow:
        0 7px 18px
        rgba(150,20,90,.2);

    transition:
        .3s;

}

.btn:hover {

    transform:
        translateY(-5px)
        scale(1.04);

    box-shadow:
        0 12px 22px
        rgba(150,20,90,.25);

}

.pink {
    background: #ed3c91;
    color: white;
}

.purple {
    background: #a466e5;
    color: white;
}

.blue {
    background: #31b9e5;
    color: white;
}

.gold {
    background: #ffb83e;
    color: white;
}


/* =====================================================
   SECTIONS
===================================================== */

section {

    max-width:
        1050px;

    margin:
        auto;

    padding:
        60px 20px;

}

.section-title {

    text-align:
        center;

    color:
        #c71e70;

    font-size:
        clamp(
            28px,
            5vw,
            42px
        );

    margin-bottom:
        12px;

}

.subtitle {

    text-align:
        center;

    color:
        #805269;

    font-size:
        17px;

    margin-bottom:
        30px;

}


/* =====================================================
   WELCOME
===================================================== */

.white-box {

    background:
        white;

    border:
        4px solid #ffc3df;

    border-radius:
        32px;

    padding:
        35px;

    text-align:
        center;

    box-shadow:
        0 10px 28px
        rgba(190,40,110,.12);

}

.white-box p {

    font-size:
        18px;

    line-height:
        1.7;

}


/* =====================================================
   ADDITION EXAMPLE
===================================================== */

.example {

    max-width:
        650px;

    margin:
        30px auto;

    padding:
        30px;

    text-align:
        center;

    background:
        #fff0f7;

    border:
        3px dashed #ff63a9;

    border-radius:
        30px;

}

.equation {

    font-size:
        clamp(
            40px,
            8vw,
            65px
        );

    font-weight:
        bold;

    color:
        #d52479;

    margin:
        15px 0;

}

.objects {

    font-size:
        32px;

}


/* =====================================================
   LEARNING CARDS
===================================================== */

.cards {

    display:
        grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(
                210px,
                1fr
            )
        );

    gap:
        20px;

}

.card {

    background:
        white;

    border:
        3px solid #ffd0e5;

    border-radius:
        28px;

    padding:
        28px 20px;

    text-align:
        center;

    box-shadow:
        0 9px 22px
        rgba(190,40,110,.1);

    transition:
        .3s;

}

.card:hover {

    transform:
        translateY(-10px);

    border-color:
        #ff5ca7;

}

.icon {

    font-size:
        50px;

    margin-bottom:
        10px;

}

.card h3 {

    color:
        #d52479;

    margin-bottom:
        10px;

}

.card p {

    color:
        #76546a;

    line-height:
        1.5;

}


/* =====================================================
   LEARN STEPS
===================================================== */

.steps {

    display:
        grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(
                220px,
                1fr
            )
        );

    gap:
        20px;

}

.step {

    background:
        white;

    border-radius:
        25px;

    padding:
        25px;

    box-shadow:
        0 8px 20px
        rgba(190,40,110,.1);

    border-left:
        8px solid #ff5ca7;

}

.step-number {

    display:
        inline-flex;

    align-items:
        center;

    justify-content:
        center;

    width:
        45px;

    height:
        45px;

    border-radius:
        50%;

    background:
        #ff5ca7;

    color:
        white;

    font-weight:
        bold;

    margin-bottom:
        12px;

}

.step h3 {

    color:
        #d52479;

    margin-bottom:
        8px;

}

.step p {

    line-height:
        1.6;

}


/* =====================================================
   PRACTICE QUESTIONS
===================================================== */

.question {

    background:
        white;

    border:
        3px solid #ffd0e5;

    border-radius:
        30px;

    padding:
        30px;

    margin-bottom:
        25px;

    text-align:
        center;

    box-shadow:
        0 8px 20px
        rgba(190,40,110,.1);

}

.question h3 {

    color:
        #a35bd9;

    margin-bottom:
        10px;

}

.question-text {

    font-size:
        38px;

    font-weight:
        bold;

    color:
        #d52479;

    margin:
        15px;

}

.answer-buttons {

    display:
        flex;

    justify-content:
        center;

    flex-wrap:
        wrap;

    gap:
        10px;

}

.answer-buttons a {

    text-decoration:
        none;

    background:
        #ffe0ef;

    color:
        #bd216c;

    padding:
        13px 25px;

    border-radius:
        25px;

    font-weight:
        bold;

    transition:
        .3s;

}

.answer-buttons a:hover {

    background:
        #ff5ca7;

    color:
        white;

    transform:
        scale(1.05);

}


/* =====================================================
   CSS FEEDBACK
===================================================== */

/*
   When the user clicks an answer,
   the browser goes to the feedback target.
*/

.feedback {

    display:
        none;

    margin-top:
        15px;

    padding:
        15px;

    border-radius:
        20px;

    font-weight:
        bold;

}


/* Question 1 */

#q1correct:target {

    display:
        block;

    background:
        #d9f8e6;

    color:
        #16834c;

}

#q1wrong:target {

    display:
        block;

    background:
        #ffe1ed;

    color:
        #c5296d;

}


/* Question 2 */

#q2correct:target {

    display:
        block;

    background:
        #d9f8e6;

    color:
        #16834c;

}

#q2wrong:target {

    display:
        block;

    background:
        #ffe1ed;

    color:
        #c5296d;

}


/* Question 3 */

#q3correct:target {

    display:
        block;

    background:
        #d9f8e6;

    color:
        #16834c;

}

#q3wrong:target {

    display:
        block;

    background:
        #ffe1ed;

    color:
        #c5296d;

}


/* =====================================================
   PLAY GAME
===================================================== */

.game {

    background:
        linear-gradient(
            135deg,
            #ff4fa3,
            #a466e5
        );

    color:
        white;

    border-radius:
        35px;

    padding:
        40px 25px;

    text-align:
        center;

    box-shadow:
        0 15px 30px
        rgba(160,40,120,.2);

}

.game h3 {

    font-size:
        30px;

    margin-bottom:
        12px;

}

.game-question {

    max-width:
        400px;

    margin:
        25px auto;

    background:
        white;

    color:
        #d52479;

    padding:
        25px;

    border-radius:
        25px;

    font-size:
        38px;

    font-weight:
        bold;

}


/* =====================================================
   CHALLENGE
===================================================== */

.challenge {

    background:
        white;

    border:
        5px solid #ffbd42;

    border-radius:
        35px;

    padding:
        40px;

    text-align:
        center;

    box-shadow:
        0 10px 25px
        rgba(190,120,30,.15);

}

.crown {

    font-size:
        65px;

}

.challenge h2 {

    color:
        #d52479;

    margin:
        15px;

}

.challenge p {

    line-height:
        1.7;

}


/* =====================================================
   NOTES
===================================================== */

.note {

    background:
        white;

    border:
        3px solid #ffd0e5;

    border-radius:
        25px;

    padding:
        25px;

    margin-bottom:
        20px;

    box-shadow:
        0 7px 18px
        rgba(190,40,110,.1);

}

.note h3 {

    color:
        #d52479;

    margin-bottom:
        10px;

}

.note p,
.note li {

    line-height:
        1.7;

}

.note ul {

    margin-left:
        22px;

}


/* =====================================================
   MOTIVATION
===================================================== */

.motivation {

    margin-top:
        35px;

    padding:
        35px 20px;

    border-radius:
        30px;

    text-align:
        center;

    color:
        white;

    background:
        linear-gradient(
            135deg,
            #ff4fa3,
            #ff9ccc
        );

}

.motivation h2 {

    font-size:
        32px;

    margin-bottom:
        10px;

}


/* =====================================================
   FOOTER
===================================================== */

.footer {

    text-align:
        center;

    padding:
        35px 20px;

    color:
        #9b3c6d;

    font-size:
        14px;

}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:600px) {

    .navbar a {

        font-size:
            11px;

        padding:
            7px 9px;

    }

    .hero {

        margin:
            10px;

        min-height:
            450px;

    }

    .hero h1 {

        font-size:
            40px;

    }

    .float {

        display:
            none;

    }

    section {

        padding:
            45px 14px;

    }

}

</style>

</head>


